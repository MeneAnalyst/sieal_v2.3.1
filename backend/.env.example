# Copy this file to .env in the same directory (pharmacy-module/backend/.env)
# and fill in real values. Never commit the real .env file.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Population Analytics warehouse — a SEPARATE Postgres database (Supabase,
# Neon, or RDS all work). Leave unset to disable /api/analytics/* and
# /api/warehouse/* (they return a clear 503 rather than fake data).
# Example: postgresql://user:password@host:5432/resilience_art_warehouse
WAREHOUSE_DATABASE_URL=
